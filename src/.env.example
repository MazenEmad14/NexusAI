# Copy to src/.env and fill in the values marked CHANGE ME. Every setting without a default in
# helpers/config.py is listed here; the optional ones are commented out with their defaults.
# The app checks these at startup and refuses to start, listing what is wrong.

APP_NAME="mini-RAG"
APP_VERSION="0.1"

# ── uploads ──────────────────────────────────────────────────────────────────
# Content types the server accepts; the extensions (.txt .pdf .csv .xls .xlsx) are derived from them.
FILE_ALLOWED_TYPES=["text/plain", "application/pdf", "text/csv", "application/vnd.ms-excel", "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet"]
FILE_MAX_SIZE=25                  # megabytes per file
FILE_DEFAULT_CHUNK_SIZE=512000    # bytes read per step while streaming an upload

# ── databases ────────────────────────────────────────────────────────────────
MONGODB_URL="mongodb://localhost:27017/"
MONGODB_DATABASE="depi"
POSTGRES_USERNAME=postgres
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_MAIN_DATABASE=ragdb
VECTOR_DB_BACKEND="QDRANT"
VECTOR_DB_PATH="qdrant_db"
VECTOR_DB_DISTANCE_METHOD="cosine"   # cosine | dot

# ── security ─────────────────────────────────────────────────────────────────
# Required: at least 32 characters. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=
# Optional: encrypts stored Google tokens. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=

# ── LLM providers ────────────────────────────────────────────────────────────
GENERATION_BACKEND="GROQ"         # OPENAI | COHERE | GROQ | GEMINI
EMBEDDING_BACKEND="COHERE"        # OPENAI | COHERE | GEMINI (Groq cannot create embeddings)
GENERATION_MODEL_ID="llama-3.3-70b-versatile"   # a model your provider key can use
EMBEDDING_MODEL_ID="embed-multilingual-v3.0"
EMBEDDING_MODEL_SIZE=1024         # vector size of the embedding model
# Set the key of each backend you chose above; the app will not start without it.
OPENAI_API_KEY=
OPENAI_API_URL=
COHERE_API_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=
INPUT_DEFAULT_MAX_CHARACTERS=1024        # clips text that is embedded
GENERATION_DEFAULT_MAX_TOKENS=512
GENERATION_DEFAULT_TEMPERATURE=0.1
# GENERATION_MAX_INPUT_CHARACTERS=24000  # size limit of a generation prompt

# ── language ─────────────────────────────────────────────────────────────────
PRIMARY_LANG="en"                 # a folder under src/stores/llm/templates/locales
DEFAULT_LANG="en"

# ── optional (defaults suit local development) ───────────────────────────────
# ACCESS_TOKEN_MINUTES=15                 # how long a sign-in cookie is valid before it is silently renewed
# REFRESH_TOKEN_DAYS=14                   # how long a session lasts without the user signing in again
# COOKIE_SECURE=false                     # set true when served over HTTPS
# COOKIE_SAMESITE=lax                     # lax | strict | none (none needs COOKIE_SECURE=true)
# COOKIE_DOMAIN=                          # only if the frontend and API are on sibling sub-domains (.example.com)
# REFRESH_MAX_PER_IP_PER_MINUTE=30
# DEFAULT_TIMEZONE=Africa/Cairo           # zone for users who have not set their own
# DAILY_SUMMARY_HOUR=8                    # local hour the daily briefing is sent
# INBOX_CHECK_INTERVAL_MINUTES=1          # how often urgent email is checked
# THREAD_RETENTION_DAYS=30                # idle conversations are deleted after this
# WHISPER_MODEL=base                      # speech-to-text model (needs requirements-voice.txt)
# LOG_FORMAT=text                         # text (readable) or json (one object per line, for log shippers)
# GOOGLE_REDIRECT_URI=http://localhost:5000/api/v1/auth/google/callback
# FRONTEND_URL=http://localhost:5173
# CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173"]   # browser origins allowed to call the API
# GOOGLE_SEARCH_API_KEY=                  # Google Custom Search for web search (set both, or neither)
# GOOGLE_SEARCH_CX=
# LOGIN_WINDOW_MINUTES=15
# LOGIN_MAX_FAILURES_PER_ACCOUNT=5
# LOGIN_MAX_FAILURES_PER_IP=20
# SIGNUP_MAX_PER_IP_PER_HOUR=10
