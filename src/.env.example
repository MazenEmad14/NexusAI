# Copy to src/.env and fill in the values marked CHANGE ME. Every setting without a default in
# helpers/config.py must be present, so this file lists them all.

APP_NAME="mini-RAG"
APP_VERSION="0.1"

# ── uploads ──────────────────────────────────────────────────────────────────
# Content types the server accepts; the extensions (.txt .pdf .csv .xls .xlsx) are derived from them.
FILE_ALLOWED_TYPES=["text/plain", "application/pdf", "text/csv", "application/vnd.ms-excel", "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet"]
FILE_MAX_SIZE=25                  # megabytes per file
FILE_DEFAULT_CHUNK_SIZE=512000    # bytes read per step while streaming an upload

# ── databases ────────────────────────────────────────────────────────────────
MONGODB_URL="mongodb://localhost:27017/"
MONGODB_DATABASE="depi"
POSTGRES_USERNAME=postgres
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_MAIN_DATABASE=ragdb
VECTOR_DB_BACKEND="QDRANT"
VECTOR_DB_PATH="qdrant_db"
VECTOR_DB_DISTANCE_METHOD="cosine"

# ── security ─────────────────────────────────────────────────────────────────
# Required: at least 32 characters. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=
# Optional: encrypts stored Google tokens. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=

# ── LLM providers ────────────────────────────────────────────────────────────
GENERATION_BACKEND="GROQ"         # OPENAI | COHERE | GROQ | GEMINI
EMBEDDING_BACKEND="COHERE"
GENERATION_MODEL_ID="llama-3.3-70b-versatile"   # a model your provider key can use
EMBEDDING_MODEL_ID="embed-multilingual-v3.0"
EMBEDDING_MODEL_SIZE=1024
OPENAI_API_KEY=
OPENAI_API_URL=
COHERE_API_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=
INPUT_DAFAULT_MAX_CHARACTERS=1024        # clips text that is embedded (the spelling matches the settings code)
GENERATION_DAFAULT_MAX_TOKENS=512
GENERATION_DAFAULT_TEMPERATURE=0.1
# GENERATION_MAX_INPUT_CHARACTERS=24000  # size limit of a generation prompt

PRIMARY_LANG="en"
DEFAULT_LANG="en"

# ── optional overrides (defaults suit local development) ────────────────────
# DEFAULT_TIMEZONE=Africa/Cairo
# GOOGLE_REDIRECT_URI=http://localhost:5000/api/v1/auth/google/callback
# FRONTEND_URL=http://localhost:5173
# LOGIN_WINDOW_MINUTES=15
# LOGIN_MAX_FAILURES_PER_ACCOUNT=5
# LOGIN_MAX_FAILURES_PER_IP=20
# SIGNUP_MAX_PER_IP_PER_HOUR=10
